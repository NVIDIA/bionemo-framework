+        if not matching_prompt.empty:
+            metrics_hits_df.at[index, 'id_prompt'] = matching_prompt.values[0]
+
+    metrics_df = pd.merge(sequences_df[["id_prompt"]], metrics_hits_df[["id_prompt", pident_column]], on='id_prompt', how='left')
+    metrics_df[pident_column] = metrics_df[pident_column].fillna(0.0)
+    metrics_df.to_csv(output_csv, index=False)
