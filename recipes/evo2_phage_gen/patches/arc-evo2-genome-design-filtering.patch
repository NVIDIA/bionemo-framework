+        metrics_hits_df['id_prompt'] = metrics_hits_df['id_prompt'].str.split('_').str[:-1].str.join('_')
+        metrics_hits_df = metrics_hits_df.loc[
+            metrics_hits_df.groupby('id_prompt')[pident_column].idxmax()
+        ].reset_index(drop=True)
+
+    for index, row in metrics_hits_df.iterrows():
