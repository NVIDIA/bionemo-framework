+def save_mmseqs_pident_metrics(mmseqs_df: pd.DataFrame, descriptive_prefix: str, sequences_df: pd.DataFrame, output_csv: str) -> None:
+    """Save best-hit percent identity metrics before applying an MMseqs pident filter."""
+    pident_column = f'{descriptive_prefix}_mmseqs_percent_identity'
+    if mmseqs_df.empty:
+        metrics_df = sequences_df[["id_prompt"]].copy()
